# ==============================================================================
# Motor de Contratos NovaLex - Configuración de Variables de Entorno (.env.example)
# Copia este archivo como .env para configuraciones locales personalizadas:
#   cp .env.example .env          (Linux / macOS)
#   Copy-Item .env.example .env   (PowerShell Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos Relacional (PostgreSQL 15 con Autenticación SCRAM-SHA-256)
# ------------------------------------------------------------------------------
POSTGRES_USER=plurione
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_AQUI
POSTGRES_DB=contratos_db

# Cadena de conexión para red interna Docker:
DATABASE_URL=postgresql://plurione:CAMBIA_ESTA_CONTRASENA_AQUI@postgres:5432/contratos_db

# Para ejecución local fuera de Docker (Host Windows/Linux):
# DATABASE_URL=postgresql://plurione:CAMBIA_ESTA_CONTRASENA_AQUI@localhost:5432/contratos_db

# ------------------------------------------------------------------------------
# 2. Servicio de Inferencia Local Ollama (Llama 3.1 8B)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://ollama:11434
MODEL_NAME=llama3.1:8b
OLLAMA_TIMEOUT=480

# Para ejecución local fuera de Docker (Host Windows/Linux):
# OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. Seguridad y Autenticación JWT (HS256)
# ------------------------------------------------------------------------------
# OBLIGATORIO: Debe ser una clave criptográfica de al menos 32 caracteres (256 bits).
# Generación recomendada:
#   Linux/macOS:        openssl rand -hex 32
#   PowerShell/Python:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=TU_JWT_SECRET_ALEATORIO_AQUI_MINIMO_32_CARACTERES
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# ------------------------------------------------------------------------------
# 4. Configuración de CORS y Frontend
# ------------------------------------------------------------------------------
# Lista de orígenes permitidos separados por comas
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE_URL=http://localhost:8000
