# ConexiÃ³n PostgreSQL (Red interna Docker configurada con SCRAM y modo trust local en pg_hba.conf)
POSTGRES_USER=plurione
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=contratos_db
DATABASE_URL=postgresql://plurione:CAMBIA_ESTA_CONTRASENA@postgres:5432/contratos_db

# Servicio de IA Local Ollama
OLLAMA_HOST=http://ollama:11434
MODEL_NAME=llama3.1:8b

# Seguridad y AutenticaciÃ³n JWT
# OBLIGATORIO: Debe ser una clave criptogrÃ¡fica de al menos 32 caracteres (256 bits).
# GeneraciÃ³n recomendada:
#   Linux/macOS: openssl rand -hex 32
#   PowerShell/Python: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UN_SECRETO_ALEATORIO
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# ConfiguraciÃ³n de CORS y Frontend
# Lista de orÃ­genes permitidos separados por comas
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE_URL=http://localhost:8000
